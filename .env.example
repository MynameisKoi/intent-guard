# Copy to .env and fill values. Never commit .env.

# LLM (choose one provider)
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional; defaults are set per provider in config when unset
LLM_MODEL=

# Neo4j — graph topology for scans
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# MongoDB — nutrition label reports
MONGO_URI=mongodb://localhost:27017
MONGO_DB=intentguard

# Dynamic sandbox (Docker)
SANDBOX_IMAGE=intentguard-sandbox
SANDBOX_TIMEOUT=45
SANDBOX_NETWORK_NONE=true

LOG_LEVEL=INFO

# LangSmith (LangChain / LangGraph traces) — optional
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=intent-guard
LANGSMITH_BASE_URL=https://smith.langchain.com

# Helicone LLM gateway (observability + response cache) — optional
HELICONE_API_KEY=
HELICONE_CACHE_ENABLED=true
HELICONE_APP_URL=https://app.helicone.ai

# LangGraph semantic pipeline (static node cache-friendly via Helicone; then optional dynamic merge)
USE_LANGGRAPH_RUNTIME=true
