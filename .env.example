# Copy to .env and fill values. Never commit .env.

# LLM (choose one provider)
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional; defaults are set per provider in config when unset
LLM_MODEL=

# Neo4j — graph topology for scans
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# MongoDB — nutrition label reports
MONGO_URI=mongodb://localhost:27017
MONGO_DB=intentguard

# Dynamic sandbox (Docker)
SANDBOX_IMAGE=intentguard-sandbox
SANDBOX_TIMEOUT=45
SANDBOX_NETWORK_NONE=true

# Scan scope — comma-separated; defaults in config.py prune vendored and generated content
# SCAN_EXCLUDE_DIRS=.git,node_modules,__pycache__,.venv,venv,dist,build,site-packages
# SCAN_EXCLUDE_GLOBS=package-lock.json,yarn.lock,poetry.lock,*.min.js
# SCAN_FIXTURE_DIRS=demo,samples,examples,fixtures,mocks
SCAN_MAX_FILE_BYTES=512000
# HTTP surface — the API is unauthenticated, so keep it on loopback (run_server.py
# defaults to --host 127.0.0.1) and only allow the local frontend origins.
# API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_BYTES=25000000
MAX_UPLOAD_FILES=500
# Adversarial simulation. `scripted` is deterministic and free (reports capability +
# missing guardrails); `llm` runs the agent's own prompt against each attack scenario
# with mock tools and reports what it actually did, at one LLM call per scenario.
DYNAMIC_ANALYSIS=true
DYNAMIC_DRIVER=scripted
DYNAMIC_MAX_TURNS=6
# Count demo/sample/doc files toward the aggregate risk score (findings are reported either way)
SCORE_FIXTURES_IN_AGGREGATE=false
# Ceiling for heuristic-only scans (no LLM verdict); keeps regex fallbacks below Critical
HEURISTIC_MAX_SCORE=7.0

LOG_LEVEL=INFO

# LangSmith (LangChain / LangGraph traces) — optional
# LANGSMITH_TRACING_V2 / LANGSMITH_API_KEY / LANGSMITH_PROJECT are accepted as aliases.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=intent-guard
# UI host for deep links — not LANGSMITH_ENDPOINT (api.smith.langchain.com), which is the API host.
LANGSMITH_BASE_URL=https://smith.langchain.com

# Helicone LLM gateway (observability + response cache) — optional
HELICONE_API_KEY=
HELICONE_CACHE_ENABLED=true
HELICONE_APP_URL=https://us.helicone.ai

# LangGraph semantic pipeline (static node cache-friendly via Helicone; then optional dynamic merge)
USE_LANGGRAPH_RUNTIME=true
